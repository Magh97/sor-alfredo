{
  "name": "alfredos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:server": "pnpm -F server dev",
    "dev:client": "pnpm -F client dev",
    "build": "pnpm -F server build && pnpm -F client build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -F server typecheck && pnpm -F client typecheck",
    "test": "pnpm -F server test && pnpm -F client test",
    "test:server": "pnpm -F server test",
    "test:client": "pnpm -F client test",
    "test:e2e": "pnpm -F client test:e2e",
    "test:coverage": "pnpm -r test:coverage",
    "db:generate": "pnpm -F server db:generate",
    "db:migrate": "pnpm -F server db:migrate",
    "db:seed": "pnpm -F server db:seed",
    "clean": "rimraf server/dist client/dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yaml}": ["prettier --write"]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
